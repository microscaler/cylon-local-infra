---
# /etc/hf-prefetch/config.yaml — managed by Ansible (roles/hf_prefetch_service).
# Edit via inventory (hf_prefetch_models) rather than in place; re-run Ansible
# to push changes. The service reloads this file on mtime change, so adding a
# model is a `ansible-playbook … --tags hf_prefetch` away.

cache_dir: "{{ hf_prefetch_cache_dir }}"
image: "{{ hf_prefetch_image }}"
poll_interval_sec: {{ hf_prefetch_poll_interval_sec | int }}

models:
{% for m in hf_prefetch_models %}
{%   if m is string %}
  - {{ m | to_json }}
{%   else %}
  - repo: {{ m.repo | to_json }}
{%     if m.revision is defined %}
    revision: {{ m.revision | to_json }}
{%     endif %}
{%     if m.cache_dir is defined %}
    cache_dir: {{ m.cache_dir | to_json }}
{%     endif %}
{%     if m.sync_targets is defined %}
    sync_targets:
{%       for t in m.sync_targets %}
      - host: {{ t.host | to_json }}
        user: {{ t.user | default('nvidia') | to_json }}
        cache_dir: {{ t.cache_dir | default('/home/nvidia/.cache/huggingface/hub') | to_json }}
        name: {{ t.name | default(t.host) | to_json }}
{%       endfor %}
{%     endif %}
{%   endif %}
{% endfor %}

sync_targets:
{% for peer in (groups['sparks'] | sort) %}
{%   if peer != hf_prefetch_leader %}
{%     set peer_ip = hostvars[peer].hf_prefetch_interconnect_ip | default('') %}
{%     if peer_ip %}
{%       set peer_user = hostvars[peer].spark_runtime_user | default('nvidia') %}
{%       set peer_home = hostvars[peer].spark_runtime_home | default('/home/nvidia') %}
{%       set peer_hf_home = hostvars[peer].vllm_hf_home | default(peer_home ~ '/.cache/huggingface') %}
{%       set peer_cache = peer_hf_home ~ '/hub' %}
  - host: {{ peer_ip | to_json }}
    user: {{ peer_user | to_json }}
    cache_dir: {{ peer_cache | to_json }}
    name: {{ peer | to_json }}
{%     endif %}
{%   endif %}
{% endfor %}
{% if hf_prefetch_archive_enabled | default(false) | bool %}
{%   if hf_prefetch_archive_targets | length > 0 %}
{%     for t in hf_prefetch_archive_targets %}
  - host: {{ t.host | to_json }}
    user: {{ t.user | to_json }}
    cache_dir: {{ t.cache_dir | to_json }}
    name: {{ t.name | default(t.host) | to_json }}
{%     endfor %}
{%   elif 'ms02' in groups.get('dev_hosts', []) %}
{%     set _ms02 = hostvars['ms02'] %}
{%     set _archive_ip = _ms02.hf_archive_lan_ip | default(_ms02.ansible_host | default('ms02')) %}
{%     set _archive_user = _ms02.hf_archive_ssh_user | default('casibbald') %}
{%     set _archive_cache = _ms02.hf_archive_cache_dir | default('/home/casibbald/.cache/huggingface/hub') %}
  - host: {{ _archive_ip | to_json }}
    user: {{ _archive_user | to_json }}
    cache_dir: {{ _archive_cache | to_json }}
    name: "ms02"
{%   endif %}
{% endif %}

{% if hf_prefetch_env | length > 0 %}
hf_env:
{%   for k, v in (hf_prefetch_env | dictsort) %}
  {{ k }}: {{ v | to_json }}
{%   endfor %}
{% endif %}
