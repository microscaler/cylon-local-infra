# DeepSeek / Anemll vLLM env — rendered per Spark host.
HF_HOME={{ vllm_dspark_hf_container_home }}
{% if dspark_hf_hub_offline | default(true) | bool %}
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
{% else %}
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
{% endif %}
HF_HUB_DISABLE_XET=1
DSPARK_MODEL={{ dspark_model }}
{% if dspark_revision | default('') | length > 0 %}
DSPARK_REVISION={{ dspark_revision }}
{% endif %}
SERVED_MODEL_NAME={{ dspark_served_model_name }}
VLLM_HOST={{ vllm_dspark_api_host }}
VLLM_PORT={{ vllm_dspark_api_port | int }}
NODE_RANK={{ spark_dspark_node_rank }}
{% if spark_dspark_node_rank | int > 0 %}
HEADLESS=1
{% endif %}
MASTER_ADDR={{ spark_dspark_leader_ip }}
MASTER_PORT={{ vllm_dspark_master_port | int }}
VLLM_HOST_IP={{ spark_interconnect_ip }}
MAX_MODEL_LEN={{ dspark_max_model_len | int }}
MAX_NUM_SEQS={{ dspark_max_num_seqs | int }}
MAX_NUM_BATCHED_TOKENS={{ dspark_max_num_batched_tokens | int }}
LONG_PREFILL_TOKEN_THRESHOLD={{ dspark_long_prefill_token_threshold | int }}
GPU_MEMORY_UTILIZATION={{ dspark_gpu_memory_utilization }}
MTP_NUM_TOKENS={{ dspark_mtp_num_tokens | int }}
DRAFT_SAMPLE_METHOD={{ dspark_draft_sample_method }}
DEFAULT_THINKING={{ dspark_default_thinking }}
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA={{ nccl_ib_hca }}
NCCL_SOCKET_IFNAME={{ nccl_interface }}
TP_SOCKET_IFNAME={{ nccl_interface }}
GLOO_SOCKET_IFNAME={{ nccl_interface }}
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN
NCCL_IB_GID_INDEX={{ spark_nccl_ib_gid_index | default('3') }}
{% for key, value in (vllm_dspark_extra_env | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
