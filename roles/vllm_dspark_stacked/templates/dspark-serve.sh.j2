#!/usr/bin/env bash
# First-party DeepSeek serve entrypoint (Anemll image). Hotfixes are optional
# vendored copies under /opt/dspark-patches — not MiaAI launcher scripts.
set -euo pipefail
exec > /root/vllm-dspark.log 2>&1

export PATH="/usr/local/cuda/bin:/usr/local/bin:${PATH:-}"
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
export LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"

PATCH_DIR="/opt/dspark-patches"
HOTFIXES_ENABLED="{{ '1' if (vllm_dspark_hotfixes_enabled | default(true) | bool) else '0' }}"

apply_py() {
  local f="$1"
  if [ -f "$f" ]; then
    python3 "$f" || exit 1
  fi
}

apply_sh() {
  local f="$1"
  if [ -f "$f" ]; then
    bash "$f" || exit 1
  fi
}

# Encoder copy + reasoning-effort mapping when snapshot is present.
MODEL_HUB_DIR="$(printf '%s' "${DSPARK_MODEL}" | sed 's|/|--|g')"
ENCODING_SOURCE=""
if [ -n "${DSPARK_REVISION:-}" ] && [ -f "${HF_HOME}/hub/models--${MODEL_HUB_DIR}/snapshots/${DSPARK_REVISION}/encoding/encoding_dsv4.py" ]; then
  ENCODING_SOURCE="${HF_HOME}/hub/models--${MODEL_HUB_DIR}/snapshots/${DSPARK_REVISION}/encoding/encoding_dsv4.py"
fi
if [ -z "${ENCODING_SOURCE}" ]; then
  for candidate in "${HF_HOME}/hub/models--${MODEL_HUB_DIR}/snapshots/"*/encoding/encoding_dsv4.py; do
    if [ -f "${candidate}" ]; then
      ENCODING_SOURCE="${candidate}"
      break
    fi
  done
fi
if [ -n "${ENCODING_SOURCE}" ] && [ -f "${ENCODING_SOURCE}" ]; then
  cp "${ENCODING_SOURCE}" /usr/local/lib/python3.12/dist-packages/vllm/tokenizers/deepseek_v4_encoding.py || exit 1
  if [ "${HOTFIXES_ENABLED}" = "1" ]; then
    apply_py "${PATCH_DIR}/hotfix-encoding-dsv4-issue21.py"
  fi
else
  echo "WARN: encoding_dsv4.py not found under ${HF_HOME}/hub for ${DSPARK_MODEL}" >&2
fi

if [ "${HOTFIXES_ENABLED}" = "1" ] && [ -d "${PATCH_DIR}" ]; then
  apply_sh "${PATCH_DIR}/hotfix-nvfp4-ds-mla-issue22.sh"
  apply_sh "${PATCH_DIR}/hotfix-gb10-spin-wait.sh"
  for _hf in \
    hotfix-dsv4-mtp-buffer-50312.sh \
    hotfix-dsv4-skip-topk-49486.sh \
    hotfix-dsv4-dense-prefill-indexer-48407.sh \
    hotfix-dsv4-skip-empty-c128-48957.sh \
    hotfix-dsv4-flashmla-workspace-50298.sh \
    hotfix-dsv4-grammar-advance.sh
  do
    apply_sh "${PATCH_DIR}/${_hf}"
  done
  apply_py "${PATCH_DIR}/hotfix-dsv4-issue55-tool-truncation.py"
  apply_py "${PATCH_DIR}/hotfix-vllm-empty-encoder-output.py"
  apply_py "${PATCH_DIR}/hotfix-dsv4-issue27-partial-prefill-concurrency.py"
  apply_py "${PATCH_DIR}/hotfix-dsv4-issue43-decode-fairness-and-diag.py"
  apply_py "${PATCH_DIR}/hotfix-dsv4-issue26-hybrid-swa-min.py"
  apply_py "${PATCH_DIR}/hotfix-dsv4-issue133-triton-specialization.py"
  apply_py "${PATCH_DIR}/hotfix-dsv4-suppress-stops-in-reasoning.py"
fi

case "${DRAFT_SAMPLE_METHOD:-probabilistic}" in
  probabilistic|greedy) ;;
  *) echo "DRAFT_SAMPLE_METHOD must be probabilistic|greedy" >&2; exit 2 ;;
esac
SPECULATIVE_CONFIG="{\"method\":\"dspark\",\"num_speculative_tokens\":${MTP_NUM_TOKENS:-5},\"draft_sample_method\":\"${DRAFT_SAMPLE_METHOD}\"}"

case "${DEFAULT_THINKING:-max}" in
  off) DEFAULT_CHAT_TEMPLATE_KWARGS='{"thinking":false}' ;;
  low) DEFAULT_CHAT_TEMPLATE_KWARGS='{"thinking":true,"reasoning_effort":"low"}' ;;
  high) DEFAULT_CHAT_TEMPLATE_KWARGS='{"thinking":true,"reasoning_effort":"high"}' ;;
  max) DEFAULT_CHAT_TEMPLATE_KWARGS='{"thinking":true,"reasoning_effort":"max"}' ;;
  *) echo "DEFAULT_THINKING must be off|low|high|max" >&2; exit 2 ;;
esac

REVISION_ARGS=()
if [ -n "${DSPARK_REVISION:-}" ]; then
  REVISION_ARGS=(--revision "${DSPARK_REVISION}")
fi

HEADLESS_ARGS=()
if [ -n "${HEADLESS:-}" ]; then
  HEADLESS_ARGS=(--headless)
fi

CAPTURE_SIZE=$(( ${MAX_NUM_SEQS:-6} * (${MTP_NUM_TOKENS:-5} + 1) ))

exec /usr/local/bin/vllm serve "${DSPARK_MODEL}" \
  "${REVISION_ARGS[@]}" \
  --served-model-name "${SERVED_MODEL_NAME}" \
  --host "${VLLM_HOST}" \
  --port "${VLLM_PORT}" \
  --trust-remote-code \
  --tensor-parallel-size {{ dspark_tensor_parallel_size | int }} \
  --pipeline-parallel-size 1 \
  --kv-cache-dtype nvfp4_ds_mla \
  --block-size 256 \
  --max-model-len "${MAX_MODEL_LEN}" \
  --max-num-seqs "${MAX_NUM_SEQS}" \
  --max-num-batched-tokens "${MAX_NUM_BATCHED_TOKENS}" \
  --long-prefill-token-threshold "${LONG_PREFILL_TOKEN_THRESHOLD}" \
  --max-cudagraph-capture-size "${CAPTURE_SIZE}" \
  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION}" \
  --enable-prefix-caching \
  --enable-prompt-tokens-details \
  --async-scheduling \
  --enable-chunked-prefill \
  --speculative-config "${SPECULATIVE_CONFIG}" \
  --tokenizer-mode deepseek_v4 \
  --distributed-executor-backend mp \
  --moe-backend flashinfer_b12x \
  --tool-call-parser deepseek_v4 \
  --enable-auto-tool-choice \
  --reasoning-parser deepseek_v4 \
  --reasoning-config '{"reasoning_parser":"deepseek_v4","reasoning_start_str":"<think>","reasoning_end_str":"</think>"}' \
  --default-chat-template-kwargs "${DEFAULT_CHAT_TEMPLATE_KWARGS}" \
  --generation-config vllm \
  --enable-flashinfer-autotune \
  --nnodes {{ groups['sparks'] | length | int }} \
  --node-rank "${NODE_RANK}" \
  --master-addr "${MASTER_ADDR}" \
  --master-port "${MASTER_PORT}" \
  "${HEADLESS_ARGS[@]}"
