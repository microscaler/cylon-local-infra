#!/usr/bin/env bash
# GLM-5.3-Flash NVFP4 entrypoint (tonyd2wild sm121 image). Ansible-rendered.
set -euo pipefail
exec > /root/vllm-glm53.log 2>&1

export PATH="/usr/local/cuda/bin:/usr/local/bin:${PATH:-}"
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
export LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"

HEADLESS_ARGS=()
if [ -n "${HEADLESS:-}" ]; then
  HEADLESS_ARGS=(--headless)
fi

SPECULATIVE_CONFIG="{\"method\":\"mtp\",\"num_speculative_tokens\":${MTP_NUM_TOKENS:-4}}"

exec vllm serve "${GLM53_MODEL}" \
  --served-model-name "${SERVED_MODEL_NAME}" \
  --host "${VLLM_HOST}" \
  --port "${VLLM_PORT}" \
  --trust-remote-code \
  --language-model-only \
  --tensor-parallel-size {{ glm53_tensor_parallel_size | int }} \
  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION}" \
  --max-model-len "${MAX_MODEL_LEN}" \
  --max-num-seqs "${MAX_NUM_SEQS}" \
  --block-size "${BLOCK_SIZE}" \
  --moe-backend marlin \
  --kv-cache-dtype fp8_e4m3 \
  --speculative-config "${SPECULATIVE_CONFIG}" \
  --enforce-eager \
  --tool-call-parser glm47 \
  --enable-auto-tool-choice \
  --reasoning-parser glm45 \
  --default-chat-template-kwargs '{"enable_thinking":false}' \
  --distributed-executor-backend mp \
  --nnodes {{ groups['sparks'] | length }} \
  --node-rank "${NODE_RANK}" \
  --master-addr "${MASTER_ADDR}" \
  --master-port "${MASTER_PORT}" \
  "${HEADLESS_ARGS[@]}"
