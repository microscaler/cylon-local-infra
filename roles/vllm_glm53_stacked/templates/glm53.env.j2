# GLM-5.3-Flash NVFP4 / sm121 vLLM env — rendered per Spark host.
HF_HOME={{ vllm_glm53_hf_container_home }}
{% if glm53_hf_hub_offline | default(true) | bool %}
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
{% else %}
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
{% endif %}
HF_HUB_DISABLE_XET=1
GLM53_MODEL={{ glm53_model }}
SERVED_MODEL_NAME={{ glm53_served_model_name }}
VLLM_HOST={{ vllm_glm53_api_host }}
VLLM_PORT={{ vllm_glm53_api_port | int }}
NODE_RANK={{ spark_glm53_node_rank }}
{% if spark_glm53_node_rank | int > 0 %}
HEADLESS=1
{% endif %}
MASTER_ADDR={{ spark_glm53_leader_ip }}
MASTER_PORT={{ vllm_glm53_master_port | int }}
VLLM_HOST_IP={{ spark_interconnect_ip }}
VLLM_ENGINE_READY_TIMEOUT_S=3600
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
MAX_MODEL_LEN={{ glm53_max_model_len | int }}
MAX_NUM_SEQS={{ glm53_max_num_seqs | int }}
GPU_MEMORY_UTILIZATION={{ glm53_gpu_memory_utilization }}
MTP_NUM_TOKENS={{ glm53_mtp_num_tokens | int }}
BLOCK_SIZE={{ glm53_block_size | int }}
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA={{ nccl_ib_hca }}
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_SOCKET_IFNAME={{ nccl_interface }}
GLOO_SOCKET_IFNAME={{ nccl_interface }}
TP_SOCKET_IFNAME={{ nccl_interface }}
MN_IF_NAME={{ nccl_interface }}
NCCL_NVLS_ENABLE=0
NCCL_CROSS_NIC=0
NCCL_IB_MERGE_NICS=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
NCCL_IB_GID_INDEX={{ spark_nccl_ib_gid_index | default('3') }}
{% for key, value in (vllm_glm53_extra_env | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
