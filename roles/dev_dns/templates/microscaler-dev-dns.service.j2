[Unit]
Description=Microscaler split-horizon dev DNS (dnsmasq)
After=network-online.target
Wants=network-online.target
Conflicts=dnsmasq.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file={{ dev_dns_conf_path }}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
