<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ wireguard_mac_lan_route_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/sbin/route</string>
    <string>-n</string>
    <string>add</string>
    <string>-net</string>
    <string>{{ wireguard_mac_metallb_cidr }}</string>
    <string>{{ wireguard_mac_lan_gateway }}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardErrorPath</key>
  <string>/var/log/{{ wireguard_mac_lan_route_label }}.err.log</string>
  <key>StandardOutPath</key>
  <string>/var/log/{{ wireguard_mac_lan_route_label }}.out.log</string>
</dict>
</plist>
